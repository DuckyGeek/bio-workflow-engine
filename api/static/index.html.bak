<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BioWorkflow 引擎 - 控制台</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: #f0f2f5;
            color: #333;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        h1 {
            font-size: 28px;
            margin-bottom: 10px;
            color: #1a1a2e;
        }
        .subtitle {
            color: #666;
            margin-bottom: 30px;
            font-size: 14px;
        }
        .card {
            background: white;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            border: 1px solid #e8ecf1;
        }
        .card h2 {
            font-size: 18px;
            margin-bottom: 16px;
            color: #1a1a2e;
        }
        .form-row {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            align-items: flex-end;
        }
        .form-group {
            flex: 1;
            min-width: 200px;
        }
        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #555;
            margin-bottom: 4px;
        }
        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #d0d7de;
            border-radius: 8px;
            font-size: 14px;
            font-family: inherit;
            transition: border 0.2s;
        }
        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #4a6cf7;
            box-shadow: 0 0 0 3px rgba(74, 108, 247, 0.1);
        }
        .form-group textarea {
            min-height: 80px;
            resize: vertical;
            font-family: "Courier New", monospace;
            font-size: 13px;
        }
        .btn {
            padding: 10px 24px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-primary {
            background: #4a6cf7;
            color: white;
        }
        .btn-primary:hover {
            background: #3a5cd9;
        }
        .btn-danger {
            background: #e74c3c;
            color: white;
        }
        .btn-danger:hover {
            background: #c0392b;
        }
        .btn-success {
            background: #2ecc71;
            color: white;
        }
        .btn-success:hover {
            background: #27ae60;
        }
        .btn-sm {
            padding: 6px 14px;
            font-size: 12px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }
        table th {
            text-align: left;
            padding: 12px 12px 12px 0;
            border-bottom: 2px solid #e8ecf1;
            font-weight: 600;
            color: #555;
        }
        table td {
            padding: 12px 12px 12px 0;
            border-bottom: 1px solid #f0f2f5;
            vertical-align: middle;
        }
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        .status-Pending {
            background: #f39c12;
            color: white;
        }
        .status-Running {
            background: #3498db;
            color: white;
        }
        .status-Completed {
            background: #2ecc71;
            color: white;
        }
        .status-Failed {
            background: #e74c3c;
            color: white;
        }
        .status-unknown {
            background: #95a5a6;
            color: white;
        }
        .step-status {
            font-size: 12px;
            color: #666;
        }
        .step-status .done {
            color: #2ecc71;
        }
        .step-status .running {
            color: #3498db;
        }
        .step-status .pending {
            color: #95a5a6;
        }
        .empty-state {
            text-align: center;
            padding: 40px 0;
            color: #999;
        }
        .refresh-btn {
            float: right;
            background: none;
            border: 1px solid #d0d7de;
            border-radius: 8px;
            padding: 6px 16px;
            cursor: pointer;
            font-size: 13px;
        }
        .refresh-btn:hover {
            background: #f0f2f5;
        }
        .toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            padding: 14px 24px;
            border-radius: 10px;
            color: white;
            font-weight: 500;
            z-index: 1000;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.3s;
        }
        .toast.show {
            opacity: 1;
            transform: translateY(0);
        }
        .toast.success {
            background: #2ecc71;
        }
        .toast.error {
            background: #e74c3c;
        }
        .toast.info {
            background: #3498db;
        }
        .code-block {
            background: #f6f8fa;
            padding: 12px 16px;
            border-radius: 8px;
            font-family: "Courier New", monospace;
            font-size: 13px;
            overflow-x: auto;
            white-space: pre-wrap;
            word-break: break-all;
            max-height: 300px;
            overflow-y: auto;
        }
        .actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        @media (max-width: 768px) {
            .form-row {
                flex-direction: column;
            }
            .form-group {
                min-width: 100%;
            }
            table {
                font-size: 12px;
            }
            table th,
            table td {
                padding: 8px 6px 8px 0;
            }
        }
    </style>
</head>
<body>
<div class="container">
    <h1>🧬 BioWorkflow 引擎</h1>
    <p class="subtitle">面向生物信息分析的云原生工作流引擎 · 控制台</p>

    <!-- Toast 通知 -->
    <div id="toast" class="toast"></div>

    <!-- ===== 提交工作流 ===== -->
    <div class="card">
        <h2>📤 提交工作流</h2>
        <div class="form-row">
            <div class="form-group">
                <label>工作流名称</label>
                <input id="wfName" placeholder="例如: rna-seq-pipeline" value="test-$(date +%s)">
            </div>
            <div class="form-group" style="flex:2;">
                <label>工作流定义 (JSON)</label>
                <textarea id="wfJson" placeholder='[{"name":"qc","image":"alpine:latest","command":["echo","QC"]}]'>[
                        {"name": "qc", "image": "alpine:latest", "command": ["echo", "QC passed"]},
                        {"name": "align", "image": "alpine:latest", "command": ["echo", "Alignment done"], "dependsOn": ["qc"]}
                    ]</textarea>
            </div>
        </div>
        <div style="margin-top:12px;display:flex;gap:12px;flex-wrap:wrap;">
            <button class="btn btn-primary" onclick="submitWorkflow()">🚀 提交工作流</button>
            <button class="btn btn-success" onclick="loadExample()">📋 加载示例</button>
        </div>
    </div>

    <!-- ===== 工作流列表 ===== -->
    <div class="card">
        <h2>
            📋 工作流列表
            <button class="refresh-btn" onclick="loadWorkflows()">🔄 刷新</button>
        </h2>
        <div id="workflowList">
            <div class="empty-state">加载中...</div>
        </div>
    </div>
</div>

<script>
    const API_BASE = 'http://localhost:8080';

    // ============================================================
    // Toast 通知
    // ============================================================
    function showToast(message, type = 'info') {
        const t = document.getElementById('toast');
        t.textContent = message;
        t.className = 'toast ' + type + ' show';
        clearTimeout(t._hide);
        t._hide = setTimeout(() => { t.className = 'toast'; }, 3000);
    }

    // ============================================================
    // 加载示例
    // ============================================================
    function loadExample() {
        const example = [
            { name: "qc", image: "alpine:latest", command: ["echo", "QC: sample passed quality check"] },
            { name: "align", image: "alpine:latest", command: ["echo", "Alignment: reads aligned to reference"], dependsOn: ["qc"] },
            { name: "variant", image: "alpine:latest", command: ["echo", "Variant calling: SNPs detected"], dependsOn: ["align"] }
        ];
        document.getElementById('wfJson').value = JSON.stringify(example, null, 2);
        document.getElementById('wfName').value = 'example-pipeline-' + Date.now().toString().slice(-6);
        showToast('已加载示例工作流', 'info');
    }

    // ============================================================
    // 提交工作流
    // ============================================================
    async function submitWorkflow() {
        const name = document.getElementById('wfName').value.trim();
        const jsonStr = document.getElementById('wfJson').value.trim();

        if (!name) {
            showToast('请输入工作流名称', 'error');
            return;
        }
        if (!jsonStr) {
            showToast('请输入工作流定义 (JSON)', 'error');
            return;
        }

        let steps;
        try {
            steps = JSON.parse(jsonStr);
            if (!Array.isArray(steps) || steps.length === 0) {
                throw new Error('Steps must be a non-empty array');
            }
            // 验证每个 step 的必要字段
            for (const s of steps) {
                if (!s.name || !s.image || !s.command) {
                    throw new Error('每个步骤必须包含 name, image, command');
                }
            }
        } catch (e) {
            showToast('❌ JSON 格式错误: ' + e.message, 'error');
            return;
        }

        const payload = { name, steps };

        try {
            const resp = await fetch(API_BASE + '/workflows', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();
            if (resp.ok) {
                showToast('✅ 工作流 ' + name + ' 提交成功!', 'success');
                document.getElementById('wfName').value = '';
                loadWorkflows();
            } else {
                showToast('❌ 提交失败: ' + (data.error || JSON.stringify(data)), 'error');
            }
        } catch (e) {
            showToast('❌ 请求失败: ' + e.message, 'error');
        }
    }

    // ============================================================
    // 加载工作流列表
    // ============================================================
    async function loadWorkflows() {
        const container = document.getElementById('workflowList');
        container.innerHTML = '<div class="empty-state">加载中...</div>';

        try {
            const resp = await fetch(API_BASE + '/workflows');
            const data = await resp.json();

            if (!resp.ok) {
                container.innerHTML = '<div class="empty-state">❌ 加载失败: ' + (data.error || '') + '</div>';
                return;
            }

            const workflows = data.workflows || [];
            if (workflows.length === 0) {
                container.innerHTML = '<div class="empty-state">暂无工作流，点击上方提交一个吧 🚀</div>';
                return;
            }

            let html = `
                    <table>
                        <thead>
                            <tr>
                                <th>名称</th>
                                <th>状态</th>
                                <th>步骤</th>
                                <th>开始时间</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                `;

            for (const wf of workflows) {
                const name = wf.metadata?.name || 'unknown';
                const status = wf.status?.phase || 'Pending';
                const startTime = wf.status?.startTime || '-';
                const stepStatus = wf.status?.stepStatus || {};

                // 渲染步骤状态
                let stepsHtml = '';
                const stepNames = Object.keys(stepStatus);
                if (stepNames.length === 0) {
                    stepsHtml = '<span class="step-status">等待...</span>';
                } else {
                    stepsHtml = stepNames.map(s => {
                        const st = stepStatus[s] || 'Pending';
                        const cls = st.toLowerCase();
                        return `<span class="step-status"><span class="${cls}">●</span> ${s}: ${st}</span>`;
                    }).join(' ');
                }

                // 状态徽章
                const statusClass = 'status-' + status;

                html += `
                        <tr>
                            <td><strong>${name}</strong></td>
                            <td><span class="status-badge ${statusClass}">${status}</span></td>
                            <td>${stepsHtml}</td>
                            <td style="font-size:12px;color:#888;">${startTime}</td>
                            <td>
                                <div class="actions">
                                    <button class="btn btn-primary btn-sm" onclick="viewWorkflow('${name}')">查看</button>
                                    <button class="btn btn-danger btn-sm" onclick="deleteWorkflow('${name}')">删除</button>
                                </div>
                            </td>
                        </tr>
                    `;
            }

            html += '</tbody></table>';
            container.innerHTML = html;

        } catch (e) {
            container.innerHTML = '<div class="empty-state">❌ 请求失败: ' + e.message + '</div>';
        }
    }

    // ============================================================
    // 查看工作流详情
    // ============================================================
    async function viewWorkflow(name) {
        try {
            const resp = await fetch(API_BASE + '/workflows/' + name);
            const data = await resp.json();
            if (resp.ok) {
                const wf = data.workflow || data;
                showToast('📄 查看 ' + name, 'info');
                alert('工作流详情:\n\n' + JSON.stringify(wf, null, 2));
            } else {
                showToast('❌ 获取失败: ' + (data.error || ''), 'error');
            }
        } catch (e) {
            showToast('❌ 请求失败: ' + e.message, 'error');
        }
    }

    // ============================================================
    // 删除工作流
    // ============================================================
    async function deleteWorkflow(name) {
        if (!confirm('确定要删除工作流 "' + name + '" 吗？\n（将同时删除所有关联的 Job 和 Pod）')) {
            return;
        }
        try {
            const resp = await fetch(API_BASE + '/workflows/' + name, {
                method: 'DELETE'
            });
            const data = await resp.json();
            if (resp.ok) {
                showToast('🗑️ 已删除: ' + name, 'success');
                loadWorkflows();
            } else {
                showToast('❌ 删除失败: ' + (data.error || ''), 'error');
            }
        } catch (e) {
            showToast('❌ 请求失败: ' + e.message, 'error');
        }
    }

    // ============================================================
    // 自动刷新 (每 10 秒)
    // ============================================================
    let autoRefresh = setInterval(loadWorkflows, 10000);

    // ============================================================
    // 页面加载时自动加载列表
    // ============================================================
    document.addEventListener('DOMContentLoaded', loadWorkflows);

    // 点击任意地方关闭 alert 风格的弹窗，但 alert 无法被关闭，所以保留原样
    console.log('🧬 BioWorkflow 控制台已加载');
    console.log('💡 提示: 自动刷新每 10 秒更新一次');
</script>
</body>
</html>